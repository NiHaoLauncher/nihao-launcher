{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "nihao-laucnher",
    "version": "0.1.0"
  },
  "tauri": {
    "bundle": {
      "identifier": "ua.bogdancater.nihao-launcher",
      "active": true,
      "targets": "all",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    },
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "app": {
        "all": true
      },
      "window": {
        "all": false,
        "close": true,
        "hide": true,
        "minimize": true,
        "maximize": true,
        "unmaximize": true,
        "unminimize": true,
        "setTitle": true,
        "show": true,
        "startDragging": true
      },
      "dialog": {
        "all": false,
        "ask": false,
        "confirm": false,
        "message": false,
        "open": true,
        "save": true
      },
      "process": {
        "all": false,
        "relaunch": true
      }
    },
    "windows": [
      {
        "title": "NiHao Launcher",
        "width": 1000,
        "height": 600,
        "decorations": false,
        "resizable": false,
        "transparent": true,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
